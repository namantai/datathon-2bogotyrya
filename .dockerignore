# Deny by default. Both builds use the repository root as context.
**
!backend/
!backend/Dockerfile
!backend/pyproject.toml
!backend/src/
!backend/src/**
!frontend/
!frontend/Dockerfile
!frontend/nginx.conf
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/tsconfig.app.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/scripts/
!frontend/scripts/check-production.mjs

# Defence in depth even if someone puts private artifacts inside src/.
**/.env
**/.env.*
**/.git
**/.venv
**/node_modules
**/__pycache__
**/*.pyc
**/*.log
**/*.mov
**/*.mp4
**/*.avi
**/*.mkv
**/*.webm
**/*.jpg
**/*.jpeg
**/*.png
**/*.db
**/*.db-*
**/*.sqlite*
**/*.pt
**/*.pth
**/*.onnx
**/*.safetensors
**/*.ckpt
**/*.pem
**/*.key
