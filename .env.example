# Safe local-development example. Copy to backend/.env and replace the key.
APP_NAME="ForteBank DATATHON API"
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_API_KEY=replace-with-a-long-random-local-secret
APP_ANALYZER_MODE=fake

# Local persistence and bounded resource limits.
APP_STORAGE_DIR=./storage
APP_DATABASE_PATH=./storage/jobs.sqlite3
APP_MAX_UPLOAD_BYTES=134217728
APP_UPLOAD_CHUNK_BYTES=1048576
APP_MAX_QUEUE_SIZE=8
APP_ANALYSIS_TIMEOUT_SEC=240

# FFprobe must be installed locally. Validation never calls a cloud service.
APP_FFPROBE_PATH=ffprobe
APP_FFPROBE_TIMEOUT_SEC=10

# Never commit backend/.env or a real API key. Production rejects this
# placeholder and also rejects APP_ANALYZER_MODE=fake.
